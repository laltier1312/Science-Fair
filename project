import React, { useState } from "react";
import { MapContainer, TileLayer, useMap } from "react-leaflet";
import "leaflet/dist/leaflet.css";

const TrafficLayer = () => {
  const map = useMap();

  // Load traffic layer from OpenTraffic (Example URL, replace with actual API if needed)
  const trafficTile = "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png";

  return <TileLayer url={trafficTile} opacity={0.5} />;
};

const TrafficMap = () => {
  const [location, setLocation] = useState([18.0425, -63.0548]); // Sint Maarten coords

  return (
    <div>
      <h2 className="text-center font-bold text-xl">Sint Maarten Live Traffic</h2>
      <MapContainer
        center={location}
        zoom={12}
        style={{ height: "80vh", width: "100%" }}
      >
        <TileLayer
          url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
        />
        <TrafficLayer />
      </MapContainer>
    </div>
  );
};

export default TrafficMap;

